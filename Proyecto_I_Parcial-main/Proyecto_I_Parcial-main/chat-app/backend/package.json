{
  "name": "chat-app-backend",
  "version": "2.0.0",
  "description": "Backend escalable para aplicación de chat en tiempo real con gestión de salas",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:scalable": "node server-scalable.js",
    "start:production": "NODE_ENV=production USE_POSTGRES=true USE_REDIS=true node server-scalable.js",
    "dev": "nodemon server.js",
    "dev:scalable": "USE_REDIS=true nodemon server-scalable.js",
    "cluster": "NODE_ENV=production node server-scalable.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:verbose": "jest --verbose",
    "migrate": "node scripts/migrate.js",
    "benchmark": "node scripts/benchmark.js",
    "build": "echo \"No build step required\""
  },
  "keywords": [
    "chat",
    "socket.io",
    "nodejs",
    "realtime",
    "rooms",
    "scalable",
    "redis",
    "postgresql"
  ],
  "author": "Tu Nombre",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.2.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.1.4",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.1",
    "helmet": "^7.0.0",
    "ioredis": "^5.3.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.0",
    "prom-client": "^14.2.0",
    "redis": "^4.6.7",
    "socket.io": "^4.7.2",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.0",
    "winston": "^3.9.0"
  },
  "devDependencies": {
    "artillery": "^2.0.0",
    "jest": "^29.5.0",
    "node-fetch": "^3.3.2",
    "nodemon": "^3.0.1",
    "socket.io-client": "^4.8.1",
    "supertest": "^6.3.3"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.7",
    "utf-8-validate": "^6.0.3"
  }
}